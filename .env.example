APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DEFAULT_HOST=localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=e-cidade-bd-1
DB_PORT=5432
DB_DATABASE=ecidade
DB_USERNAME=ecidade
DB_PASSWORD=ecidade

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MFA_ENABLED=false
MFA_ADMINS_ONLY=true
MFA_ALLOW_ADMIN_BYPASS=false
MFA_REQUIRED_GROUPS=
MFA_REQUIRED_USERS=
MFA_USER_GROUPS_JSON={}
MFA_CODE_LENGTH=6
MFA_TTL_SECONDS=300
MFA_VERIFY_MAX_ATTEMPTS=5
MFA_VERIFY_LOCK_PRIMARY_SECONDS=120
MFA_VERIFY_LOCK_SECONDARY_SECONDS=600
MFA_VERIFY_LOCK_TERTIARY_SECONDS=1800

AUTH_USERS_PROVIDER=legacy
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_MINUTES=2
AUTH_LOGIN_PROGRESSIVE_WINDOW_MINUTES=60
AUTH_LOGIN_BLOCK_PRIMARY_SECONDS=120
AUTH_LOGIN_BLOCK_SECONDARY_SECONDS=600
AUTH_LOGIN_BLOCK_TERTIARY_SECONDS=1800
AUTH_EVENTS_RETENTION_DAYS=7
AUTH_ACCESS_POLICY_ENABLED=false
AUTH_ACCESS_POLICY_TIMEZONE=America/Sao_Paulo
AUTH_ACCESS_POLICY_ALLOW_ADMIN_BYPASS=false
AUTH_ACCESS_POLICY_DENY_MESSAGE=Acesso bloqueado pela politica de horario/perfil.
AUTH_ACCESS_DEFAULT_ALLOWED_WEEKDAYS=
AUTH_ACCESS_DEFAULT_START_TIME=
AUTH_ACCESS_DEFAULT_END_TIME=
AUTH_ACCESS_DEFAULT_EXPIRES_AT=
AUTH_ACCESS_GROUP_RULES_JSON={}
AUTH_ACCESS_USER_RULES_JSON={}
AUTH_ACCESS_USER_GROUPS_JSON={}
AUTH_EXTERNAL_ENABLED=false
AUTH_EXTERNAL_ALLOWED_PROVIDERS=govbr,google,a1,a3
AUTH_EXTERNAL_PROVIDER_SECRETS_JSON={}
AUTH_EXTERNAL_ALLOW_UNSIGNED=false
AUTH_EXTERNAL_DEFAULT_INSTIT=1
AUTH_EXTERNAL_REDIRECT_PATH=/web/welcome
AUTH_EXTERNAL_ENFORCE_CLAIMS_EXPIRATION=true
AUTH_EXTERNAL_MAX_CLOCK_SKEW_SECONDS=60
AUTH_EXTERNAL_ENFORCE_NONCE=true
AUTH_EXTERNAL_NONCE_TTL_SECONDS=600
WEB_AUDIT_ENABLED=true
WEB_AUDIT_CHANNEL=web_audit
WEB_AUDIT_INCLUDE_QUERY=true
WEB_AUDIT_INCLUDE_INPUT_KEYS=true
WEB_AUDIT_LOG_LEVEL=info
WEB_AUDIT_LOG_DAYS=35

BACKUP_ENABLED=true
BACKUP_DIR=/var/backups/ecidade
BACKUP_RETENTION_ACTIVE_DAYS=15
BACKUP_RETENTION_ARCHIVE_DAYS=35
BACKUP_PGHOST=${DB_HOST}
BACKUP_PGPORT=${DB_PORT}
BACKUP_PGDATABASE=${DB_DATABASE}
BACKUP_PGUSER=${DB_USERNAME}
BACKUP_PGPASSWORD=${DB_PASSWORD}
BACKUP_DOWNLOAD_ENABLED=true
BACKUP_A3_REQUIRED=true
BACKUP_A3_ALLOWED_ISSUER_REGEX=
BACKUP_A3_ALLOW_BYPASS=false
BACKUP_DOWNLOAD_LINK_TTL_MINUTES=5

SLA_TARGET_PERCENT=99.9
SLA_SAMPLE_LOG_PATH=/var/www/html/storage/logs/sla_samples.log
SLA_REPORT_LOG_PATH=/var/www/html/storage/logs/sla_reports.log
OPS_SCHEDULE_ENABLED=false
OPS_HEALTH_SNAPSHOT_INTERVAL_MINUTES=5
OPS_HEALTH_SNAPSHOT_BASE_URL=http://localhost:8282
OPS_SLA_REPORT_HOURS=24

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

WAS_ACCESS_KEY_ID=XXXXXXXXXXXXXXXXXXXX
WAS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WAS_DEFAULT_REGION=us-east-1
WAS_BUCKET=Bucket-Name
WAS_URL=s3.wasabisys.com
