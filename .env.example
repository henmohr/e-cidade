APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DEFAULT_HOST=localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=e-cidade-bd-1
DB_PORT=5432
DB_DATABASE=ecidade
DB_USERNAME=ecidade
DB_PASSWORD=ecidade

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MFA_ENABLED=false
MFA_ADMINS_ONLY=true
MFA_CODE_LENGTH=6
MFA_TTL_SECONDS=300

AUTH_USERS_PROVIDER=legacy
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_MINUTES=2
AUTH_LOGIN_PROGRESSIVE_WINDOW_MINUTES=60
AUTH_LOGIN_BLOCK_PRIMARY_SECONDS=120
AUTH_LOGIN_BLOCK_SECONDARY_SECONDS=600
AUTH_LOGIN_BLOCK_TERTIARY_SECONDS=1800

BACKUP_ENABLED=true
BACKUP_DIR=/var/backups/ecidade
BACKUP_RETENTION_ACTIVE_DAYS=15
BACKUP_RETENTION_ARCHIVE_DAYS=35
BACKUP_PGHOST=${DB_HOST}
BACKUP_PGPORT=${DB_PORT}
BACKUP_PGDATABASE=${DB_DATABASE}
BACKUP_PGUSER=${DB_USERNAME}
BACKUP_PGPASSWORD=${DB_PASSWORD}

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

WAS_ACCESS_KEY_ID=XXXXXXXXXXXXXXXXXXXX
WAS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WAS_DEFAULT_REGION=us-east-1
WAS_BUCKET=Bucket-Name
WAS_URL=s3.wasabisys.com
